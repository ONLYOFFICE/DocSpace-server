<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitiveEnabled>true</CentralPackageTransitiveEnabled>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>
  <!-- Common properties for all projects -->
  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Company>Ascensio System SIA</Company>
    <AssemblyVersion>4.1.0</AssemblyVersion>
    <ProductVersion>4.1.0</ProductVersion>
    <Copyright>(c) Ascensio System SIA. All rights reserved</Copyright>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisLevel>latest</AnalysisLevel>
  </PropertyGroup>
  <!-- Release configuration properties -->
  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|AnyCPU'">
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
  </PropertyGroup>
  <ItemGroup>
    <!-- Sorted alphabetically for maintainability.
         Projects can temporarily use VersionOverride metadata on PackageReference
         until the versions are moved here. -->
    <PackageVersion Include="Amazon.Extensions.S3.Encryption" Version="4.0.3" />
    <PackageVersion Include="AnyAscii" Version="0.3.3" />
    <PackageVersion Include="Apache.NMS.AMQP" Version="2.4.0" />
    <PackageVersion Include="ARSoft.Tools.NetStandard.DXSdata" Version="1.0.0" />
    <PackageVersion Include="Asp.Versioning.Http" Version="10.2.3" />
    <PackageVersion Include="Asp.Versioning.Mvc" Version="10.2.1" />
    <PackageVersion Include="Asp.Versioning.Mvc.ApiExplorer" Version="10.2.1" />
    <PackageVersion Include="Aspire.Hosting.JavaScript" Version="13.6.5" />
    <PackageVersion Include="Aspire.Hosting.MySql" Version="13.6.5" />
    <PackageVersion Include="Aspire.Hosting.PostgreSQL" Version="13.6.5" />
    <PackageVersion Include="Aspire.Hosting.RabbitMQ" Version="13.6.5" />
    <PackageVersion Include="Aspire.Hosting.Redis" Version="13.6.5" />
    <PackageVersion Include="AspNetCore.HealthChecks.Kafka" Version="9.0.0" />
    <PackageVersion Include="AspNetCore.HealthChecks.MySql" Version="9.0.0" />
    <PackageVersion Include="AspNetCore.HealthChecks.NpgSql" Version="9.0.0" />
    <PackageVersion Include="AspNetCore.HealthChecks.Rabbitmq" Version="9.0.0" />
    <PackageVersion Include="AspNetCore.HealthChecks.Redis" Version="9.0.0" />
    <PackageVersion Include="AspNetCore.HealthChecks.UI" Version="9.0.0" />
    <PackageVersion Include="AspNetCore.HealthChecks.UI.Client" Version="9.0.0" />
    <PackageVersion Include="AspNetCore.HealthChecks.UI.InMemory.Storage" Version="9.0.0" />
    <PackageVersion Include="Autofac.Configuration" Version="7.0.0" />
    <PackageVersion Include="Autofac.Extensions.DependencyInjection" Version="10.0.0" />
    <PackageVersion Include="AWS.Logger.NLog" Version="5.0.1" />
    <PackageVersion Include="AWSSDK.CloudFront" Version="4.0.103" />
    <PackageVersion Include="AWSSDK.Core" Version="4.0.102.11" />
    <PackageVersion Include="AWSSDK.DynamoDBv2" Version="4.0.107.3" />
    <PackageVersion Include="AWSSDK.Extensions.CloudFront.Signers" Version="4.0.101.8" />
    <PackageVersion Include="AWSSDK.S3" Version="4.0.104.4" />
    <PackageVersion Include="AWSSDK.SimpleEmail" Version="4.0.100.18" />
    <PackageVersion Include="Bogus" Version="35.6.5" />
    <PackageVersion Include="Box.V2.Core" Version="5.8.0" />
    <PackageVersion Include="CommandLineParser" Version="2.9.1" />
    <PackageVersion Include="CommunityToolkit.Aspire.Hosting.MailPit" Version="13.6.0" />
    <PackageVersion Include="CommunityToolkit.Aspire.Hosting.McpInspector" Version="13.6.0" />
    <PackageVersion Include="CommunityToolkit.Aspire.Hosting.MySql.Extensions" Version="13.6.0" />
    <PackageVersion Include="CommunityToolkit.Aspire.Hosting.PostgreSQL.Extensions" Version="13.6.0" />
    <PackageVersion Include="Confluent.Kafka" Version="2.15.1" />
    <PackageVersion Include="coverlet.collector" Version="6.0.4" />
    <PackageVersion Include="CsvHelper" Version="33.1.0" />
    <PackageVersion Include="DistributedLock.Redis" Version="1.1.1" />
    <PackageVersion Include="DistributedLock.ZooKeeper" Version="1.0.0" />
    <PackageVersion Include="DocSpace.API.SDK" Version="4.1.0" />
    <PackageVersion Include="DocSpace.Webhooks.SDK" Version="4.1.0" />
    <PackageVersion Include="DocuSign.eSign.dll" Version="8.4.0" />
    <PackageVersion Include="DotNetOpenAuth.Ultimate" Version="4.3.4.13329" />
    <PackageVersion Include="Dropbox.Api" Version="7.0.0" />
    <PackageVersion Include="EtaEmre.NetEscapades.EnumGenerators" Version="1.0.0-beta07" />
    <PackageVersion Include="FirebaseAdmin" Version="3.4.0" />
    <PackageVersion Include="FluentAssertions" Version="7.0.0" />
    <PackageVersion Include="FolkerKinzel.VCards" Version="8.2.0" />
    <PackageVersion Include="Google.Api.Gax" Version="4.15.1" />
    <PackageVersion Include="Google.Api.Gax.Rest" Version="4.15.1" />
    <PackageVersion Include="Google.Apis.Auth" Version="1.77.0" />
    <PackageVersion Include="Google.Apis.Core" Version="1.77.0" />
    <PackageVersion Include="Google.Apis.Drive.v3" Version="1.77.0.4276" />
    <PackageVersion Include="Google.Apis.Storage.v1" Version="1.77.0.4290" />
    <PackageVersion Include="Google.Cloud.Storage.V1" Version="5.0.0" />
    <PackageVersion Include="GoogleAuthenticator" Version="3.2.0" />
    <PackageVersion Include="Grpc" Version="2.46.6" />
    <PackageVersion Include="HtmlAgilityPack" Version="1.12.4" />
    <PackageVersion Include="Ical.Net" Version="4.3.1" />
    <PackageVersion Include="Joonasw.AspNetCore.SecurityHeaders" Version="6.0.0" />
    <PackageVersion Include="JWT" Version="11.1.0" />
    <PackageVersion Include="log4net" Version="3.0.3" />
    <PackageVersion Include="Magick.NET-Q8-AnyCPU" Version="15.0.0" />
    <PackageVersion Include="MailKit" Version="4.18.1" />
    <!-- Transitive pin: Aspire.Hosting 13.6.5 (via StreamJsonRpc 2.25.29) pulls MessagePack 2.5.302, which has a known moderate-severity vulnerability (GHSA-qhrr-8q5h-9q3h, fixed in 2.5.303). Stay on 2.x: StreamJsonRpc is built against the 2.x API. Drop the pin once Aspire ships a patched dependency. -->
    <PackageVersion Include="MessagePack" Version="2.5.307" />
    <PackageVersion Include="Microsoft.AspNet.WebApi.Core" Version="5.3.0" />
    <PackageVersion Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="11.0.0" />
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="11.0.0" />
    <!-- Transitive pin: WireMock.Net 2.21.0 (test projects) pulls Microsoft.AspNetCore.Http 2.3.9 -> WebUtilities 2.3.0, which has a known moderate-severity vulnerability (GHSA-6527-9fp8-r4x6, fixed in 2.3.14). Drop the pin once WireMock.Net is updated to a version that brings 2.3.14 itself. -->
    <PackageVersion Include="Microsoft.AspNetCore.WebUtilities" Version="2.3.14" />
    <PackageVersion Include="Microsoft.Bcl.Memory" Version="11.0.0" />
    <PackageVersion Include="Microsoft.Build" Version="18.12.2" />
    <!-- No central pin for Microsoft.CodeAnalysis.*: ASC.Analyzers sets its own version with VersionOverride, and the
         Roslyn that Microsoft.EntityFrameworkCore.Design brings resolves to one consistent version, the one its
         Workspaces packages pin exactly (see the comment in common/ASC.Analyzers/ASC.Analyzers.csproj). -->
    <PackageVersion Include="Microsoft.Data.Sqlite" Version="11.0.0" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore" Version="11.0.0" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Abstractions" Version="11.0.0" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="11.0.0" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.InMemory" Version="11.0.0" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Relational" Version="11.0.0" />
    <!-- Microsoft.Extensions.AI* stays on 10.x: Microsoft.SemanticKernel.Abstractions is built against
         Microsoft.Extensions.AI 10.5.0 (open-ended range), and whether it runs on the 11.0 major was not verified.
         Move them together with Semantic Kernel after checking that. -->
    <PackageVersion Include="Microsoft.Extensions.AI" Version="10.11.0" />
    <PackageVersion Include="Microsoft.Extensions.AI.Abstractions" Version="10.11.0" />
    <PackageVersion Include="Microsoft.Extensions.AI.OpenAI" Version="10.11.0" />
    <!-- Moves with the TFM: on net11.0 dotnet-getdocument needs tools/net11.0/GetDocument.Insider.dll, which only 11.x
         ships. Its tool is built against Microsoft.OpenApi 3.x - see the Microsoft.OpenApi pin below. -->
    <PackageVersion Include="Microsoft.Extensions.ApiDescription.Server" Version="11.0.0" />
    <PackageVersion Include="Microsoft.Extensions.Caching.StackExchangeRedis" Version="11.0.0" />
    <PackageVersion Include="Microsoft.Extensions.Configuration" Version="11.0.0" />
    <PackageVersion Include="Microsoft.Extensions.Configuration.Binder" Version="11.0.0" />
    <PackageVersion Include="Microsoft.Extensions.Configuration.CommandLine" Version="11.0.0" />
    <PackageVersion Include="Microsoft.Extensions.Configuration.Json" Version="11.0.0" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection" Version="11.0.0" />
    <PackageVersion Include="Microsoft.Extensions.Hosting" Version="11.0.0" />
    <PackageVersion Include="Microsoft.Extensions.Hosting.Systemd" Version="11.0.0" />
    <PackageVersion Include="Microsoft.Extensions.Hosting.WindowsServices" Version="11.0.0" />
    <PackageVersion Include="Microsoft.Extensions.Http" Version="11.0.0" />
    <PackageVersion Include="Microsoft.Extensions.Http.Polly" Version="11.0.0" />
    <PackageVersion Include="Microsoft.Extensions.Http.Resilience" Version="11.0.0" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="11.0.0" />
    <PackageVersion Include="Microsoft.Extensions.Options" Version="11.0.0" />
    <PackageVersion Include="Microsoft.Extensions.Resilience" Version="11.0.0" />
    <PackageVersion Include="Microsoft.IdentityModel.Protocols.OpenIdConnect" Version="8.22.0" />
    <PackageVersion Include="Microsoft.ML.Tokenizers.Data.Cl100kBase" Version="2.0.0" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.10.1" />
    <PackageVersion Include="Microsoft.OneDriveSDK" Version="2.1.0" />
    <!-- Transitive pin: the dotnet-getdocument tool from Microsoft.Extensions.ApiDescription.Server 11.0.0
         is built against Microsoft.OpenApi 3.11.0 and loads it from the service output folder, so OpenApiGenerateDocuments
         fails with a FileLoadException when an older one lands there. Swashbuckle 11.0.1 needs 3.11.0 as well.
         Keep this at or above the version the ApiDescription.Server tool ships. -->
    <PackageVersion Include="Microsoft.OpenApi" Version="3.11.1" />
    <PackageVersion Include="Microsoft.ML.Tokenizers" Version="2.0.0" />
    <PackageVersion Include="Microsoft.SemanticKernel.Core" Version="1.80.1" />
    <PackageVersion Include="Microsoft.SharePoint.Client" Version="14.0.4762.1000" />
    <PackageVersion Include="Microsoft.Windows.Compatibility" Version="11.0.0" />
    <PackageVersion Include="Microting.EntityFrameworkCore.MySql" Version="11.0.0" />
    <PackageVersion Include="Microting.EntityFrameworkCore.MySql.Json.Microsoft" Version="11.0.0" />
    <PackageVersion Include="Moq" Version="4.21.0" />
    <PackageVersion Include="MSTest.TestFramework" Version="3.6.3" />
    <PackageVersion Include="MySql.Data" Version="9.2.0" />
    <!-- Transitive pin: AspNetCore.HealthChecks.MySql 9.0.0 (used by Aspire.Hosting.MySql in the AppHost) pulls MySqlConnector 2.3.1, which has a known moderate-severity vulnerability (GHSA-473q-m89c-ghf8, fixed in 2.6.1). Keep it at the version Microting.EntityFrameworkCore.MySql brings to the services (3.0.0 for Microting 11.0.0): a lower pin fails the restore with NU1109. AspNetCore.HealthChecks.MySql 9.0.0 is built against MySqlConnector 2.x; the AppHost resolves 3.0.0 (its project.assets.json), and the MySQL stack of the integration suites starts and passes with it; the health check was not tested on its own. -->
    <PackageVersion Include="MySqlConnector" Version="3.0.0" />
    <PackageVersion Include="Newtonsoft.Json" Version="13.0.4" />
    <PackageVersion Include="NLog" Version="5.5.0" />
    <PackageVersion Include="NLog.DiagnosticSource" Version="5.2.3" />
    <PackageVersion Include="NLog.Targets.ElasticSearch" Version="7.7.0" />
    <PackageVersion Include="NLog.Targets.OpenTelemetryProtocol" Version="1.2.9" />
    <PackageVersion Include="NLog.Targets.Syslog" Version="7.0.0" />
    <PackageVersion Include="NLog.Web.AspNetCore" Version="5.5.0" />
    <PackageVersion Include="Novell.Directory.Ldap.NETStandard" Version="3.6.0" />
    <PackageVersion Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="11.0.0" />
    <PackageVersion Include="NUnit" Version="4.2.2" />
    <PackageVersion Include="NUnit.Analyzers" Version="3.3.0" />
    <PackageVersion Include="NUnit3TestAdapter" Version="4.6.0" />
    <PackageVersion Include="NVelocity" Version="1.2.0" />
    <!-- Pre-release: consider upgrading when stable -->
    <PackageVersion Include="OpenTelemetry" Version="1.19.1" />
    <PackageVersion Include="OpenTelemetry.Api" Version="1.19.1" />
    <PackageVersion Include="OpenTelemetry.Exporter.InfluxDB" Version="1.0.0-alpha.14" />
    <PackageVersion Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.19.1" />
    <PackageVersion Include="OpenTelemetry.Extensions.Hosting" Version="1.19.1" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.AspNetCore" Version="1.19.0" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.EntityFrameworkCore" Version="1.19.1-beta.1" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.Http" Version="1.19.0" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.Process" Version="1.19.0-rc.1" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.Runtime" Version="1.19.0" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.StackExchangeRedis" Version="1.19.0-beta.1" />
    <PackageVersion Include="OpenSearch.Client" Version="2.2.0" />
    <PackageVersion Include="OpenSearch.Net" Version="2.2.0" />
    <PackageVersion Include="protobuf-net" Version="3.2.56" />
    <PackageVersion Include="RabbitMQ.Client" Version="7.2.2" />
    <PackageVersion Include="Rackspace" Version="1.0.0" />
    <PackageVersion Include="RedisRateLimiting" Version="1.2.1" />
    <PackageVersion Include="RedisRateLimiting.AspNetCore" Version="1.2.1" />
    <PackageVersion Include="Refit" Version="16.3.0" />
    <PackageVersion Include="Refit.HttpClientFactory" Version="16.3.0" />
    <PackageVersion Include="ResXResourceReader.NetStandard" Version="1.1.0" />
    <PackageVersion Include="Riok.Mapperly" Version="4.3.1" />
    <PackageVersion Include="Scalar.AspNetCore" Version="3.1.1" />
    <PackageVersion Include="Scalar.AspNetCore.Swashbuckle" Version="3.1.1" />
    <PackageVersion Include="SharpZipLib" Version="2.4.3" />
    <PackageVersion Include="SkiaSharp" Version="4.153.1" />
    <PackageVersion Include="SkiaSharp.NativeAssets.Linux" Version="4.153.1" />
    <PackageVersion Include="SkiaSharp.NativeAssets.Linux.NoDependencies" Version="4.153.1" />
    <PackageVersion Include="SocketIOClient" Version="4.0.5" />
