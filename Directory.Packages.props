    <PackageVersion Include="StackExchange.Redis.Extensions.Core" Version="11.0.0" />
    <PackageVersion Include="StackExchange.Redis.Extensions.Newtonsoft" Version="11.0.0" />
    <PackageVersion Include="Svg.Skia" Version="5.2.3" />
    <PackageVersion Include="Swashbuckle.AspNetCore" Version="11.0.1" />
    <PackageVersion Include="Swashbuckle.AspNetCore.Annotations" Version="11.0.1" />
    <PackageVersion Include="Swashbuckle.AspNetCore.SwaggerGen" Version="11.0.1" />
    <PackageVersion Include="System.IdentityModel.Tokens.Jwt" Version="8.22.0" />
    <PackageVersion Include="Aspire.Hosting.Testing" Version="13.6.5" />
    <PackageVersion Include="Telegram.Bot" Version="22.7.6" />
    <PackageVersion Include="TweetinviAPI" Version="5.0.4" />
    <PackageVersion Include="Twilio" Version="7.13.5" />
    <PackageVersion Include="UAParser" Version="3.1.47" />
    <PackageVersion Include="WebDav.Client" Version="2.9.0" />
    <PackageVersion Include="WireMock.Net" Version="2.21.0" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="4.0.1" />
    <PackageVersion Include="xunit.v3" Version="4.0.2" />
    <PackageVersion Include="xunit.v3.extensibility.core" Version="4.0.2" />
    <PackageVersion Include="YamlDotNet" Version="18.1.0" />
    <PackageVersion Include="ZiggyCreatures.FusionCache" Version="2.9.0" />
    <PackageVersion Include="ZiggyCreatures.FusionCache.Backplane.StackExchangeRedis" Version="2.9.0" />
    <PackageVersion Include="ZiggyCreatures.FusionCache.OpenTelemetry" Version="2.9.0" />
