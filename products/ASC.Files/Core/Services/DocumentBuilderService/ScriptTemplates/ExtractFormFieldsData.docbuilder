builder.OpenFile(${sourceFileUrl});

// GetFormsData() gives the shape Document Server posts on submission. A PDF without the form signature opens as a
// plain PDF, whose document has no form data.
var doc = Api.GetDocument();

// The tips the form author set, by field key; left out when this build of the editor cannot read them.
var tips = {};
try {
    var forms = doc.GetAllForms ? doc.GetAllForms() : [];
    for (var f = 0; f < forms.length; f++) {
        var formKey = forms[f].GetFormKey ? forms[f].GetFormKey() : "";
        var tip = forms[f].GetTipText ? forms[f].GetTipText() : "";
        if (formKey && tip) {
            tips[formKey] = tip;
        }
    }
} catch (e) {
    tips = {};
}

var json = JSON.stringify({ formsdata: doc.GetFormsData ? doc.GetFormsData() : null, tips: tips });

// The result travels as a text file, so non-ASCII characters are escaped; a backslash literal fails the build.
var escaped = "";
for (var i = 0; i < json.length; i++) {
    var code = json.charCodeAt(i);
    if (code < 128) {
        escaped += json.charAt(i);
    } else {
        var hex = code.toString(16);
        while (hex.length < 4) {
            hex = "0" + hex;
        }
        escaped += String.fromCharCode(92) + "u" + hex;
    }
}

GlobalVariable["formsData"] = escaped;
builder.CloseFile();

builder.CreateFile("docx");
Api.GetDocument().GetElement(0).AddText(GlobalVariable["formsData"]);
builder.SaveFile("txt", "${tempFileName}");
builder.CloseFile();
