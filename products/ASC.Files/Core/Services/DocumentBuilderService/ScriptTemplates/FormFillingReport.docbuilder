builder.CreateFile("xlsx");

var inputData = ${inputData};
var DATA_FONT_SIZE = 12;
var HEADER_FONT_SIZE = 11;
var BASE_ROW_HEIGHT = 19.5;
var LINE_HEIGHT = 15;
var MAX_ROW_HEIGHT = 125;
var MAX_COLUMN_WIDTH = 100;
// The longest address a HYPERLINK formula takes; a longer one is set as a cell hyperlink.
var MAX_FORMULA_URL = 255;

function toColumnName(num) {
    for (var res = '', a = 1, b = 26; (num -= a) >= 0; a = b, b *= 26) {
        res = String.fromCharCode(parseInt((num % b) / a) + 65) + res;
    }
    return res;
}

function lineStats(text) {
    if (!text || typeof text !== 'string') return { length: 0, breaks: 0 };
    var lines = text.split('\n');
    var length = 0;
    for (var i = 0; i < lines.length; i++) {
        if (lines[i].length > length) length = lines[i].length;
    }
    return { length: length, breaks: lines.length - 1 };
}

// A formula string literal: quotes are doubled.
function quote(text) {
    return '"' + String(text).replace(/"/g, '""') + '"';
}

// The whole sheet is written with one call and formatted by ranges: cell-by-cell calls dominate the build time.
function writeSheet(worksheet, sheet) {
    var columnCount = sheet.keys.length;
    var rowCount = sheet.values.length + 1;
    if (columnCount === 0) return;

    var lastColumn = toColumnName(columnCount);
    var linkColumn = toColumnName(columnCount);
    var data = [sheet.keys.slice()];
    var widths = [];
    var tallRows = [];
    var longLinks = [];

    for (var c = 0; c < columnCount; c++) {
        widths.push(lineStats(sheet.keys[c]).length);
    }

    for (var r = 0; r < sheet.values.length; r++) {
        var row = sheet.values[r].slice();
        var breaks = 0;
        for (var c = 0; c < row.length; c++) {
            var stats = lineStats(row[c]);
            if (stats.length > widths[c]) widths[c] = stats.length;
            if (stats.breaks > breaks) breaks = stats.breaks;
            if (row[c] == null) row[c] = "";
            // Only text columns keep a leading "=" as text; elsewhere the quote prefix does.
            else if (sheet.formats[c] !== "@" && /^[=+\-@]/.test(row[c])) row[c] = "'" + row[c];
        }
        var link = sheet.links[r];
        if (link && link.length > MAX_FORMULA_URL) {
            longLinks.push({ row: r + 2, url: link });
            link = null;
        }
        row.push(link ? "=HYPERLINK(" + quote(link) + "," + quote(inputData.linkText) + ")" : "");
        if (sheet.links[r] && inputData.linkText.length > widths[columnCount - 1]) widths[columnCount - 1] = inputData.linkText.length;
        if (breaks > 0) tallRows.push({ row: r + 2, breaks: breaks });
        data.push(row);
    }

    // Text format is set before the values, so an answer starting with "=" stays text.
    for (var c = 0; c < sheet.formats.length; c++) {
        var column = toColumnName(c + 1);
        worksheet.GetRange(column + "1:" + column + rowCount).SetNumberFormat(sheet.formats[c]);
    }
    worksheet.GetRange("A1:" + toColumnName(sheet.formats.length) + "1").SetNumberFormat("@");

    var all = worksheet.GetRange("A1:" + lastColumn + rowCount);
    all.SetValue(data);
    all.SetFontColor(Api.CreateColorFromRGB(0, 0, 0));
    all.SetAlignHorizontal("left");
    all.SetAlignVertical("center");
    all.SetRowHeight(BASE_ROW_HEIGHT);

    var header = worksheet.GetRange("A1:" + lastColumn + "1");
    header.SetFontSize(HEADER_FONT_SIZE);
    header.SetBold(true);

    if (rowCount > 1) {
        var body = worksheet.GetRange("A2:" + lastColumn + rowCount);
        body.SetFontSize(DATA_FONT_SIZE);
        body.SetWrap(true);

        var links = worksheet.GetRange(linkColumn + "2:" + linkColumn + rowCount);
        links.SetFontColor(Api.CreateColorFromRGB(5, 99, 193));
        links.SetUnderline("single");
        links.SetWrap(false);
    }

    for (var i = 0; i < longLinks.length; i++) {
        worksheet.SetHyperlink(linkColumn + longLinks[i].row, longLinks[i].url, "", inputData.linkText, inputData.linkText);
    }

    for (var i = 0; i < tallRows.length; i++) {
        worksheet.GetRange("A" + tallRows[i].row).SetRowHeight(Math.min(BASE_ROW_HEIGHT + tallRows[i].breaks * LINE_HEIGHT, MAX_ROW_HEIGHT));
    }

    for (var c = 0; c < columnCount; c++) {
        worksheet.GetRange(toColumnName(c + 1) + "1").SetColumnWidth(Math.min(widths[c] * 1.2, MAX_COLUMN_WIDTH));
    }

    worksheet.GetRange("A1").Select();
}

// One sheet per group of form versions, the current one first.
for (var s = 0; s < inputData.sheets.length; s++) {
    if (s > 0) {
        Api.AddSheet(inputData.sheets[s].name);
    }
    var worksheet = Api.GetActiveSheet();
    worksheet.SetName(inputData.sheets[s].name);
    writeSheet(worksheet, inputData.sheets[s]);
}
Api.GetSheets()[0].SetActive();

builder.SaveFile("xlsx", "${tempFileName}");
builder.CloseFile();
