{
  "permissions": {
    "allow": [
      "Bash(dotnet build *)",
      "Bash(dotnet test *)",
      "Bash(dotnet format *)",
      "Bash(yarn typecheck*)",
      "Bash(yarn lint*)",
      "Bash(yarn test*)",
      "Bash(yarn vitest *)",
      "Bash(yarn format:check*)",
      "Bash(yarn check*)",
      "Bash(openspec *)",
      "mcp__codegraph__*"
    ],
    "additionalDirectories": [
      "../buildtools/config",
      "../Logs",
      "../tests"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/ai-chat-check.sh",
            "timeout": 60
          }
        ]
      }
    ]
  },
  "extraKnownMarketplaces": {
    "dotnet-agent-skills": {
      "source": {
        "source": "github",
        "repo": "dotnet/skills"
      }
    }
  },
  "enabledPlugins": {
    "csharp-lsp@claude-plugins-official": true,
    "microsoft-docs@claude-plugins-official": true,
    "context7@claude-plugins-official": true,
    "dotnet-diag@dotnet-agent-skills": true,
    "dotnet-msbuild@dotnet-agent-skills": true
  }
}
