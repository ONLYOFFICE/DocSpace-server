{
  "permissions": {
    "allow": [
      "Bash(dotnet build *)",
      "Bash(dotnet test *)",
      "Bash(dotnet format *)",
      "Bash(openspec *)"
    ],
    "additionalDirectories": [
      "../buildtools/config",
      "../Logs",
      "../tests"
    ]
  },
  "extraKnownMarketplaces": {
    "dotnet-agent-skills": {
      "source": {
        "source": "github",
        "repo": "dotnet/skills"
      }
    }
  },
  "enabledPlugins": {
    "csharp-lsp@claude-plugins-official": true,
    "microsoft-docs@claude-plugins-official": true,
    "context7@claude-plugins-official": true,
    "dotnet-diag@dotnet-agent-skills": true,
    "dotnet-msbuild@dotnet-agent-skills": true
  }
}
