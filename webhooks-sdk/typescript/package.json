{
  "name": "@onlyoffice/docspace-webhooks-sdk",
  "version": "1.0.0",
  "description": "A simple TypeScript SDK for receiving ONLYOFFICE DocSpace webhooks",
  "homepage": "https://www.onlyoffice.com",
  "author": "Ascensio System SIA <integration@onlyoffice.com> (https://www.onlyoffice.com)",
  "maintainers": [
    "Ascensio System SIA <integration@onlyoffice.com> (https://www.onlyoffice.com)"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ONLYOFFICE/docspace-webhooks-sdk-typescript.git"
  },
  "bugs": {
    "url": "https://github.com/ONLYOFFICE/docspace-webhooks-sdk-typescript/issues",
    "email": "support@onlyoffice.com"
  },
  "keywords": [
    "onlyoffice",
    "docspace",
    "sdk",
    "webhooks"
  ],
  "license": "Apache-2.0",
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "default": "./dist/src/index.js"
    },
    "./package.json": "./package.json"
  },
  "engines": {
    "node": ">=18"
  },
  "files": [
    "dist/src",
    "dist/generated"
  ],
  "scripts": {
    "build": "tsc",
    "prepare": "npm run build",
    "test": "tsc && node --test \"dist/test/**/*.test.js\"",
    "sample": "tsc && node dist/samples/log-webhook.js"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "typescript": "^5.7.2"
  }
}
