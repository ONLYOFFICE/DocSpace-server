<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>com.onlyoffice</groupId>
  <artifactId>docspace-webhooks-sdk-kotlin</artifactId>
  <version>1.0.0</version>
  <packaging>jar</packaging>

  <name>com.onlyoffice:docspace-webhooks-sdk-kotlin</name>
  <description>A simple Kotlin SDK for receiving ONLYOFFICE DocSpace webhooks</description>
  <url>https://github.com/ONLYOFFICE/docspace-webhooks-sdk-kotlin</url>

  <licenses>
    <license>
      <name>Apache-2.0</name>
      <url>https://www.apache.org/licenses/LICENSE-2.0.txt</url>
    </license>
  </licenses>

  <developers>
    <developer>
      <email>integration@onlyoffice.com</email>
      <organization>Ascensio System SIA</organization>
      <organizationUrl>https://www.onlyoffice.com/</organizationUrl>
    </developer>
  </developers>

  <scm>
    <connection>scm:git:git@github.com:ONLYOFFICE/docspace-webhooks-sdk-kotlin.git</connection>
    <developerConnection>scm:git:git@github.com:ONLYOFFICE/docspace-webhooks-sdk-kotlin.git</developerConnection>
    <url>https://github.com/ONLYOFFICE/docspace-webhooks-sdk-kotlin</url>
  </scm>


  <properties>
    <kotlin.version>2.4.21</kotlin.version>
    <moshi.version>1.15.1</moshi.version>
    <maven.compiler.release>17</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
  </properties>

  <dependencies>
    <dependency>
      <groupId>org.jetbrains.kotlin</groupId>
      <artifactId>kotlin-stdlib</artifactId>
      <version>${kotlin.version}</version>
    </dependency>
    <!-- The generated models' only external dependency. -->
    <dependency>
      <groupId>com.squareup.moshi</groupId>
      <artifactId>moshi</artifactId>
      <version>${moshi.version}</version>
    </dependency>
    <!-- Reflection adapter: the models carry no @JsonClass(generateAdapter),
         so no kapt/KSP codegen step is required. -->
    <dependency>
      <groupId>com.squareup.moshi</groupId>
      <artifactId>moshi-kotlin</artifactId>
      <version>${moshi.version}</version>
    </dependency>
    <!-- moshi-kotlin brings an older kotlin-reflect; keep it on the compiler's version. -->
    <dependency>
      <groupId>org.jetbrains.kotlin</groupId>
      <artifactId>kotlin-reflect</artifactId>
      <version>${kotlin.version}</version>
    </dependency>
  </dependencies>

  <build>
    <sourceDirectory>src/main/kotlin</sourceDirectory>
    <plugins>
      <plugin>
        <groupId>org.jetbrains.kotlin</groupId>
        <artifactId>kotlin-maven-plugin</artifactId>
        <version>${kotlin.version}</version>
        <executions>
          <execution>
            <id>compile</id>
            <phase>compile</phase>
            <goals><goal>compile</goal></goals>
            <configuration>
              <sourceDirs>
                <sourceDir>${project.basedir}/src/main/kotlin</sourceDir>
                <!-- Contract models; wiped and rewritten on every regeneration -->
                <sourceDir>${project.basedir}/generated/src/main/kotlin</sourceDir>
              </sourceDirs>
            </configuration>
          </execution>
        </executions>
        <configuration>
          <jvmTarget>17</jvmTarget>
        </configuration>
      </plugin>
      <plugin>
        <!-- The sample is compiled with the SDK so that exec:java can run it,
             but it is not part of the published artifact. -->
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-jar-plugin</artifactId>
        <version>3.4.2</version>
        <configuration>
          <excludes>
            <exclude>com/onlyoffice/docspace/webhooks/samples/**</exclude>
          </excludes>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>exec-maven-plugin</artifactId>
        <version>3.5.0</version>
        <configuration>
          <mainClass>com.onlyoffice.docspace.webhooks.samples.LogWebhookKt</mainClass>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
