<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>com.onlyoffice</groupId>
  <artifactId>docspace-webhooks-sdk</artifactId>
  <version>1.0.0</version>
  <packaging>jar</packaging>

  <name>com.onlyoffice:docspace-webhooks-sdk</name>
  <description>A simple Java SDK for receiving ONLYOFFICE DocSpace webhooks</description>
  <url>https://github.com/ONLYOFFICE/docspace-webhooks-sdk-java</url>

  <licenses>
    <license>
      <name>Apache-2.0</name>
      <url>https://www.apache.org/licenses/LICENSE-2.0.txt</url>
    </license>
  </licenses>

  <developers>
    <developer>
      <email>integration@onlyoffice.com</email>
      <organization>Ascensio System SIA</organization>
      <organizationUrl>https://www.onlyoffice.com/</organizationUrl>
    </developer>
  </developers>

  <scm>
    <connection>scm:git:git@github.com:ONLYOFFICE/docspace-webhooks-sdk-java.git</connection>
    <developerConnection>scm:git:git@github.com:ONLYOFFICE/docspace-webhooks-sdk-java.git</developerConnection>
    <url>https://github.com/ONLYOFFICE/docspace-webhooks-sdk-java</url>
  </scm>


  <properties>
    <maven.compiler.release>17</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
  </properties>

  <dependencies>
    <!-- The generated models' only external dependency. -->
    <dependency>
      <groupId>com.google.code.gson</groupId>
      <artifactId>gson</artifactId>
      <version>2.11.0</version>
    </dependency>
    <!-- The models annotate nullable getters with the fully-qualified
         @javax.annotation.Nullable, so it never shows up in an import scan. -->
    <dependency>
      <groupId>com.google.code.findbugs</groupId>
      <artifactId>jsr305</artifactId>
      <version>3.0.2</version>
    </dependency>
    <!-- javax.annotation.Generated: moved out of the JDK in Java 11, and
         jsr305 carries only @Nullable, not @Generated. -->
    <dependency>
      <groupId>javax.annotation</groupId>
      <artifactId>javax.annotation-api</artifactId>
      <version>1.3.2</version>
    </dependency>
    <!-- WebhookEnvelope.payload is untyped in the contract, which the Java
         generator renders as JsonNullable. -->
    <dependency>
      <groupId>org.openapitools</groupId>
      <artifactId>jackson-databind-nullable</artifactId>
      <version>0.2.6</version>
    </dependency>
  </dependencies>

  <build>
    <sourceDirectory>src/main/java</sourceDirectory>
    <plugins>
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>build-helper-maven-plugin</artifactId>
        <version>3.6.0</version>
        <executions>
          <execution>
            <phase>generate-sources</phase>
            <goals><goal>add-source</goal></goals>
            <configuration>
              <sources>
                <!-- Contract models; wiped and rewritten by ../generate.sh -->
                <source>generated/src/main/java</source>
              </sources>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <!-- The sample is compiled with the SDK so that exec:java can run it,
             but it is not part of the published artifact. -->
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-jar-plugin</artifactId>
        <version>3.4.2</version>
        <configuration>
          <excludes>
            <exclude>com/onlyoffice/docspace/webhooks/samples/**</exclude>
          </excludes>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>exec-maven-plugin</artifactId>
        <version>3.5.0</version>
        <configuration>
          <mainClass>com.onlyoffice.docspace.webhooks.samples.LogWebhook</mainClass>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
