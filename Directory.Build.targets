<Project>
  <!--
    Imported after every project file, so it also extends the <NoWarn> of the csprojs that set it without $(NoWarn).

    NU1608 is suppressed by decision of the maintainer (2026-11-20): Npgsql.EntityFrameworkCore.PostgreSQL
    11.0.0-rc.3 names Microsoft.EntityFrameworkCore and .Relational exactly 11.0.0-rc.3 while EF Core is pinned to
    11.0.0 (Directory.Packages.props), and PostgreSQL is not fully supported yet. A NoWarn on that PackageReference
    alone does not reach the projects that get the provider transitively. These two constraints are the only NU1608
    a restore of ASC.Web.slnx and ASC.Tests.slnx reports without this group; check that again before adding a pin
    with an exact dependency. Remove this group together with the direct EF references in
    common/ASC.Core.Common/ASC.Core.Common.csproj once Npgsql 11.0.0 ships.
  -->
  <PropertyGroup>
    <NoWarn>$(NoWarn);NU1608</NoWarn>
  </PropertyGroup>
</Project>
