{
  "name": "docbuilder-language-server",
  "version": "0.1.0",
  "description": "Language server for ONLYOFFICE Document Builder scripts (*.docbuilder): completion, hover, diagnostics, preview",
  "license": "AGPL-3.0-only",
  "private": true,
  "type": "module",
  "bin": {
    "docbuilder-language-server": "src/server.mjs"
  },
  "scripts": {
    "check": "node src/check.mjs",
    "test": "node --test test/*.test.mjs",
    "bundle": "node build.mjs"
  },
  "dependencies": {
    "typescript": "5.9.3",
    "vscode-languageserver": "9.0.1",
    "vscode-languageserver-textdocument": "1.0.12"
  },
  "devDependencies": {
    "esbuild": "0.25.10"
  }
}
