<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Configuration" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Binder" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" />
    <PackageReference Include="Spectre.Console.Cli" />
    <PackageReference Include="YamlDotNet" />
  </ItemGroup>

  <ItemGroup>
    <None Update="appsettings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <!--
    Emit the OpenAPI document for the ASC.NewAi Node service.

    The .NET services produce their `json/*.json` via the ApiDescription
    build tool, but ASC.NewAi is an Express/TypeScript service outside the
    solution, so its document is generated by a small Node emitter instead.
    `yarn openapi` writes `json/newai_2.0.json` next to the others, which
    OpenapiJoiner then merges (registered as `pathToJsonNewAI` in
    appsettings.json).

    Gated on OpenApiGenerateDocuments (set to true for the documentation
    build via Directory.Build.props), matching how the .NET services only
    emit their documents in that same context. Requires Node + Yarn on the
    build agent.
  -->
  <PropertyGroup>
    <NewAiServiceDir>$(MSBuildProjectDirectory)\..\..\..\ASC.NewAi</NewAiServiceDir>
  </PropertyGroup>

  <Target Name="EmitNewAiOpenApi"
          BeforeTargets="Build"
          Condition="'$(OpenApiGenerateDocuments)' == 'true'">
    <Message Importance="high" Text="Generating ASC.NewAi OpenAPI document (newai_2.0.json)..." />
    <Exec Command="yarn install --immutable" WorkingDirectory="$(NewAiServiceDir)" />
    <Exec Command="yarn openapi" WorkingDirectory="$(NewAiServiceDir)" />
  </Target>

  <!--
    Render the Markdown API reference as part of building the documentation
    solution, so that Build/Rebuild refreshes the per-service `json/*.md` the same way it
    refreshes the `json/*_2.0.json` OpenAPI documents.

    These references exist purely to order the build: the Markdown is rendered
    from the joined `json/*_2.0.json` documents, which the service projects emit
    during their own Build. Without them MSBuild is free to build this project
    first and would silently render last build's documents. ReferenceOutputAssembly
    keeps it an ordering constraint only - no service assembly is referenced.

    Gated on OpenApiGenerateDocuments so that building this project on its own
    stays a few seconds and does not drag in the whole service graph.
  -->
  <ItemGroup Condition="'$(OpenApiGenerateDocuments)' == 'true'">
    <ProjectReference Include="..\..\..\..\web\ASC.Web.Api\ASC.Web.Api.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\..\..\..\products\ASC.Files\Server\ASC.Files.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\..\..\..\products\ASC.People\Server\ASC.People.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\..\..\..\products\ASC.AI\Server\ASC.AI.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\..\..\services\ASC.Data.Backup\ASC.Data.Backup.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\..\..\services\ASC.ApiSystem\ASC.ApiSystem.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <!--
    The tool resolves the paths from appsettings.json against the current
    directory, so it has to run from its own output directory. The `Markdown`
    command renders through the `my-markdown` custom generator, so this step also
    rebuilds the generator jar with Maven - budget for that on top of the
    generation itself. Requires openapi-generator-cli, Maven and a JDK on the
    build agent.
  -->
  <Target Name="GenerateMarkdownApiDocs"
          AfterTargets="Build"
          Condition="'$(OpenApiGenerateDocuments)' == 'true'">
    <Message Importance="high" Text="Rendering Markdown API documentation (json/*.md, one document per service)..." />
    <Exec Command="dotnet &quot;$(TargetPath)&quot; Markdown" WorkingDirectory="$(TargetDir)" />
  </Target>

</Project>
