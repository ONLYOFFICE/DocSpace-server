<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Configuration" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Binder" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" />
    <PackageReference Include="Spectre.Console.Cli" />
    <PackageReference Include="YamlDotNet" />
  </ItemGroup>

  <ItemGroup>
    <None Update="appsettings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <!--
    Emit the OpenAPI document for the ASC.AI.Chat Node service.

    The .NET services produce their `json/*.json` via the ApiDescription
    build tool, but ASC.AI.Chat is an Express/TypeScript service outside the
    solution, so its document is generated by a small Node emitter instead.
    `yarn openapi` writes `json/aichat_2.0.json` next to the others, which
    OpenapiJoiner then merges (registered as `pathToJsonAiChat` in
    appsettings.json).

    Gated on OpenApiGenerateDocuments (set to true for the documentation
    build via Directory.Build.props), matching how the .NET services only
    emit their documents in that same context. Requires Node + Yarn on the
    build agent.
  -->
  <PropertyGroup>
    <AiChatServiceDir>$(MSBuildProjectDirectory)\..\..\..\ASC.AI.Chat</AiChatServiceDir>
  </PropertyGroup>

  <Target Name="EmitAiChatOpenApi"
          BeforeTargets="Build"
          Condition="'$(OpenApiGenerateDocuments)' == 'true'">
    <Message Importance="high" Text="Generating ASC.AI.Chat OpenAPI document (aichat_2.0.json)..." />
    <Exec Command="yarn install --immutable" WorkingDirectory="$(AiChatServiceDir)" />
    <Exec Command="yarn openapi" WorkingDirectory="$(AiChatServiceDir)" />
  </Target>

</Project>
