from {{packageName}} import Configuration, ApiClient, AuthenticationApi, FoldersApi, BackupApi, RoomsApi
from {{packageName}}.api.authentication.authentication_api import AuthenticationApi
from {{packageName}}.api.backup.backup_api import BackupApi
from {{packageName}}.api.files.folders_api import FoldersApi
from {{packageName}}.models.auth_request_dto import AuthRequestDto
from {{packageName}}.models.create_folder_request import CreateFolderRequest
from {{packageName}}.models.delete_folder_request import DeleteFolderRequest
from {{packageName}}.models.start_backup_request_dto import StartBackupRequestDto
from {{packageName}}.models.backup_storage_type import BackupStorageType
from {{packageName}}.models.sorted_by_type import SortedByType
from {{packageName}}.models.sort_order import SortOrder
import time

def main():
    config = Configuration()
    config.host = "https://your-docspace.onlyoffice.com"
    
    with ApiClient(config) as api_client:
        auth_instance = AuthenticationApi(api_client)
        
        auth_request_data = AuthRequestDto()
        auth_request_data.password = "{{userPassword}}"
        auth_request_data.user_name = "{{userEmail}}"
        
        try:
            auth_response = auth_instance.authenticate_me(auth_request_data)
            token = auth_response.response.token
            custom_headers = {"Authorization": f"Bearer {token}"}
            folder_instance = FoldersApi(api_client)
            responseFolderMy = folder_instance.get_my_folder(_headers=custom_headers)
            print(responseFolderMy.response.current.id)

            folderMyId = responseFolderMy.response.current.id
            folderData = CreateFolderRequest(title="TestTitle")
            createFolder = folder_instance.create_folder(folder_id=folderMyId, create_folder_request=folderData, _headers=custom_headers)
            print(createFolder.response.id)

            newFolderId = createFolder.response.id
            getFolder = folder_instance.get_folder_by_folder_id(folder_id=newFolderId, _headers=custom_headers)
            print(getFolder.status_code)

            newFolderData = CreateFolderRequest(title="Updated title")
            updateFolder = folder_instance.rename_folder(folder_id=newFolderId, create_folder_request=newFolderData, _headers=custom_headers)
            print(updateFolder.status_code)

            deleteFolderData = DeleteFolderRequest()
            deleteFolderData.delete_after = False
            deleteFolderData.immediately = True
            deleteFolder = folder_instance.delete_folder(folder_id=newFolderId, delete_folder_request=deleteFolderData, _headers=custom_headers)
            print(deleteFolder.status_code)

            room_instance = RoomsApi(api_client)
            getRoom = room_instance.with_fields("current.security,folders.id").get_rooms_folder(count=100, sort_by="DateAndTime", sort_order=SortOrder.Descending, _headers=custom_headers)
            print(getRoom.status_code)

            backup_instanse = BackupApi(api_client)
            backup_data = StartBackupRequestDto()
            backup_data.dump = False
            backup_data.storage_type = BackupStorageType.DataStore
            createBackup = backup_instanse.start_backup(start_backup_request_dto=backup_data, _headers=custom_headers)
            if createBackup.status_code == 200:
                print("Backup started")
            
            backupProgress = backup_instanse.get_backup_progress(_headers=custom_headers)
            print(backupProgress.response.is_completed)
            while True:
                progress = backup_instanse.get_backup_progress(_headers=custom_headers)
                if progress.response.is_completed:
                    print("Backup completed")
                    break
                time.sleep(1.0)

        except Exception as e:
            print("Exception when calling API:", e)

if __name__ == "__main__":
    main()