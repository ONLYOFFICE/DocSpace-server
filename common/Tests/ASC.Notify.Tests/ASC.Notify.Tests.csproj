<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <OutputType>exe</OutputType>

    <TestingPlatformDotnetTestSupport>true</TestingPlatformDotnetTestSupport>
    <UseMicrosoftTestingPlatformRunner>true</UseMicrosoftTestingPlatformRunner>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Aspire.Hosting.Testing" />
    <PackageReference Include="coverlet.collector">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="FluentAssertions" />
    <!-- The MailPit inbox is talked to over SMTP: MailKit for the client, MimeKit (its own dependency)
         for the message. Referenced here rather than inherited through ASC.Web.Core, so that moving
         that reference cannot turn this into an unexplained "type not found". -->
    <PackageReference Include="MailKit" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit.runner.visualstudio">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="xunit.v3" />
  </ItemGroup>

  <ItemGroup>
    <!-- The shared integration-test harness (see .claude/rules/tests.md): the Aspire host, portal
         registration, the owner credentials, the timing instrumentation and the storage cleanup.
         Anything a suite needs from it belongs there, not copied back here. -->
    <ProjectReference Include="..\ASC.Tests.Common\ASC.Tests.Common.csproj" />
    <!-- Not an Aspire resource declaration - hence IsAspireProjectResource="false" - but what makes
         Rider recognise this project as an Aspire test host and stand up its run-session endpoint.
         Without it DCP is still put into IDE execution mode with nothing to connect to: it retries a
         dead websocket forever, migrate never launches, and every project resource stays Waiting.
         ASC.Files.Tests, ASC.AI.Tests and ASC.People.Tests all carry the same pair of references. -->
    <ProjectReference Include="..\..\ASC.AppHost\ASC.AppHost.csproj" IsAspireProjectResource="false" />
    <!-- Most notify actions live in ASC.Web.Core; the two backup letters have theirs here.
         Keep this reference: DIHelper.Scan registers an assembly only when it is reachable through the
         reference graph, and ASC.Studio.Notify does not reference backup - dropping it would leave the
         backup letters unresolvable in the in-process host. -->
    <ProjectReference Include="..\..\ASC.Data.Backup.Core\ASC.Data.Backup.Core.csproj" />
    <ProjectReference Include="..\..\..\web\ASC.Web.Core\ASC.Web.Core.csproj" />
    <!-- The in-process host (LetterHost) is the Studio.Notify service's own service graph: its Startup
         is what registers the notify stack, and ASC.Api.Core is where BaseWorkerStartup lives.
         ASC.Web.Core does not reference ASC.Api.Core, so neither is reachable without these. -->
    <ProjectReference Include="..\..\ASC.Api.Core\ASC.Api.Core.csproj" />
    <ProjectReference Include="..\..\services\ASC.Studio.Notify\ASC.Studio.Notify.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

</Project>
